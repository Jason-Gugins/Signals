# Contact address embedded in the User-Agent for every HTTP request.
# SEC EDGAR REQUIRES a real contact. Set this before first run.
SIGNALS_CONTACT_EMAIL=you@example.com

# Optional: GitHub personal access token (free) raises the API limit 60/hr -> 5000/hr
GITHUB_TOKEN=

# Optional: Google Knowledge Graph identity discovery (sweep --discover).
# EKG backend (default): path to a Google Cloud service-account JSON key
# (Enterprise Knowledge Graph API enabled; install the [gkg] extra for
# google-auth). Both stages are no-ops until configured (doctor: gkg_credentials).
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: GCP project id for the EKG backend (used with the credentials above).
GKG_PROJECT_ID=
# Optional: legacy Knowledge Graph Search fallback — needs gkg_backend: kgsearch
# in config/default.yaml plus a bare API key.
GOOGLE_KGSEARCH_KEY=

# Optional: webhook for new Tier-1 alerts (Slack/Discord/n8n incoming webhook URL)
ALERT_WEBHOOK_URL=

# Optional: override DB path
SIGNALS_DB_PATH=

# Optional: Cloudflare challenge solver for managed/Turnstile challenges (techstack bypass).
# Leave blank to rely on the browser-only solve (standard JS challenge).
CLOUDFLARE_SOLVER_PROVIDER=
CLOUDFLARE_SOLVER_API_KEY=
CLOUDFLARE_BYPASS_STRATEGY=browser_first
CLOUDFLARE_HEADED_FALLBACK=false

# DataDome bypass (for G2 and other DataDome-protected sources)
DATADOME_SOLVER_PROVIDER=2captcha       # 2captcha | capsolver
DATADOME_SOLVER_API_KEY=                 # your 2captcha/capsolver API key
DATADOME_RESIDENTIAL_PROXY=              # e.g. http://user:pass@gate.provider.com:8000

# Optional: multiple alert webhooks as a JSON array. Each entry:
#   url        - webhook endpoint (https)
#   format     - "slack" (legacy text payload) or "json" (generic signed JSON)
#   secret_env - NAME of the env var holding the HMAC signing secret
#                (resolved at send time; never put the secret itself here)
#   signature  - per-webhook scheme: legacy (X-Signature, default) | hub (X-Hub-Signature-256) | stripe (Stripe-Signature t=,v1=)
# Example shape:
# ALERT_WEBHOOKS_JSON=[{"url": "https://example.com/hook", "format": "json", "secret_env": "ALERT_HOOK_SECRET"}]
ALERT_WEBHOOKS_JSON=

# Optional: SMTP email delivery for `digest --email` / `brief --email` (stdlib smtplib).
# SIGNALS_SMTP_USER_ENV / SIGNALS_SMTP_PASS_ENV name the env vars that hold the
# actual username / app-password — the credentials themselves are resolved at
# send time and never stored in config. Recipient comes from SIGNALS_EMAIL_TO
# (or a --to flag). Leave SIGNALS_SMTP_HOST blank to disable email delivery.
SIGNALS_SMTP_HOST=smtp.example.com
SIGNALS_SMTP_PORT=587
SIGNALS_SMTP_USER_ENV=SIGNALS_SMTP_USER
SIGNALS_SMTP_PASS_ENV=SIGNALS_SMTP_PASS
SIGNALS_EMAIL_TO=you@example.com
