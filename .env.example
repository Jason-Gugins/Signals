# Contact address embedded in the User-Agent for every HTTP request.
# SEC EDGAR REQUIRES a real contact. Set this before first run.
SIGNALS_CONTACT_EMAIL=you@example.com

# Optional: GitHub personal access token (free) raises the API limit 60/hr -> 5000/hr
GITHUB_TOKEN=

# Optional: webhook for new Tier-1 alerts (Slack/Discord/n8n incoming webhook URL)
ALERT_WEBHOOK_URL=

# Optional: override DB path
SIGNALS_DB_PATH=

# Optional: Cloudflare challenge solver for managed/Turnstile challenges (techstack bypass).
# Leave blank to rely on the browser-only solve (standard JS challenge).
CLOUDFLARE_SOLVER_PROVIDER=
CLOUDFLARE_SOLVER_API_KEY=
CLOUDFLARE_BYPASS_STRATEGY=browser_first
CLOUDFLARE_HEADED_FALLBACK=false

# DataDome bypass (for G2 and other DataDome-protected sources)
DATADOME_SOLVER_PROVIDER=2captcha       # 2captcha | capsolver
DATADOME_SOLVER_API_KEY=                 # your 2captcha/capsolver API key
DATADOME_RESIDENTIAL_PROXY=              # e.g. http://user:pass@gate.provider.com:8000

# Optional: multiple alert webhooks as a JSON array. Each entry:
#   url        - webhook endpoint (https)
#   format     - "slack" (legacy text payload) or "json" (generic signed JSON)
#   secret_env - NAME of the env var holding the HMAC signing secret
#                (resolved at send time; never put the secret itself here)
# Example shape:
# ALERT_WEBHOOKS_JSON=[{"url": "https://example.com/hook", "format": "json", "secret_env": "ALERT_HOOK_SECRET"}]
ALERT_WEBHOOKS_JSON=
