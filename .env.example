# Contact address embedded in the User-Agent for every HTTP request.
# SEC EDGAR REQUIRES a real contact. Set this before first run.
SIGNALS_CONTACT_EMAIL=you@example.com

# Optional: GitHub personal access token (free) raises the API limit 60/hr -> 5000/hr
GITHUB_TOKEN=

# Optional: webhook for new Tier-1 alerts (Slack/Discord/n8n incoming webhook URL)
ALERT_WEBHOOK_URL=

# Optional: override DB path
SIGNALS_DB_PATH=
